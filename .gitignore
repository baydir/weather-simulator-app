# Raw payloads cached by the collection scripts. Reproducible from
# scripts/*/collect.py, and far too bulky to track.
#
# Anchored to the repository root, and it has to be. Written "data/" this rule
# matches any directory of that name at any depth, which swept up the shipped
# correction table under src/ — a program resource, not a cache, and the one
# artifact in the project that is *not* cheaply reproducible: rebuilding it
# costs fifteen to twenty hours of Open-Meteo quota. It also short-circuited the
# placeholder rule below, git never looking inside a directory it has excluded.
/data/

# OS
.DS_Store

# Table de correction provisoire — correction identite, generee par
# scripts/calibration_grid/build.py --neutral. Jamais livree.
src/weather_simulator/calibration/data/cloud_correction_placeholder.json
